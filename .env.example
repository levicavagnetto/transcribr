# Copy this file to `.env` in the same folder as compose.yaml and fill it in.
# Keep `.env` private: it holds the Ravon password. Transcribr never shows it or logs it.
# If the password contains a `$`, wrap the value in single quotes: RAVON_PASSWORD='pa$$word'

# The Ravon admin login Transcribr uses to read call recordings (read-only).
RAVON_USERNAME=
RAVON_PASSWORD=

# The port the web app is served on, on this computer: http://<this-pc>:8000
TRANSCRIBR_PORT=8000

# Only change these if told to.
# RAVON_BASE_URL=https://admin.ravon.net
# TRANSCRIBR_IMAGE=transcribr:local
